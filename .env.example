# Public Supabase settings: these are safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma separated emails authorized to use shared Google/OpenAI integrations.
ADMIN_EMAILS=
# Server only. Never use NEXT_PUBLIC_ for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GSC_SITE_URL=https://www.farkyazilim.com/
GA4_PROPERTY_ID=
GOOGLE_ADS_CUSTOMER_ID=
# Optional legacy header; Google Cloud project access is used after 2026-09-09.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Set a currently supported version from developers.google.com/google-ads/api/docs/sunset-dates
GOOGLE_ADS_API_VERSION=
# Weekly server-side automation. Defaults off until explicitly enabled.
AUTOMATION_ENABLED=false
AUTOMATION_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Incoming webhook bound to your #ai-reports Slack channel.
SLACK_REPORT_WEBHOOK_URL=
SLACK_REPORT_CHANNEL_NAME=ai-reports
AUTOMATION_SLACK_ENABLED=false

# Google Ads live management (server only; defaults do not permit writes).
# Supabase user UUID for the person who may approve advertising spend.
ADS_AUTOMATION_USER_ID=
ADS_MUTATIONS_ENABLED=false
ADS_AUTOMATION_ENABLED=false
# Real monitor schedule, 1-15 minutes. Two observed runs are required before launch.
# Requires a suitable Vercel plan or an external authenticated scheduler.
ADS_MONITOR_INTERVAL_MINUTES=
